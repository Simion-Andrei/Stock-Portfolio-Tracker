### ==========================================
### 1. CONFIGURARE & AUTH
### ==========================================

### 1.1 Inregistrare User Nou (Ruleaza doar o data)
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "username": "trader_boss",
  "password": "password123"
}

### 1.2 Login (AICI E MAGIA CU TOKEN-UL)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "trader_boss",
  "password": "password123"
}

> {%
    // Script care ia token-ul din raspuns si il pune in variabila globala
    client.global.set("auth_token", response.body.token);
    client.log("Token salvat: " + response.body.token);
%}

### ==========================================
### 2. EXPLORARE
### ==========================================

### 2.1 Vezi ce actiuni sunt disponibile pe piata
GET http://localhost:8080/api/portfolio/stocks
Authorization: Bearer {{auth_token}}

### 2.2 Vezi portofoliul initial (Ar trebui sa fie GOL la inceput)
GET http://localhost:8080/api/portfolio
Authorization: Bearer {{auth_token}}

### ==========================================
### 3. TRANZACTIONARE (CUMPARARE & MEDIE)
### ==========================================

### 3.1 Cumpara 10 AAPL la 100$ (Investitie: 1000$)
POST http://localhost:8080/api/portfolio
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "ticker": "AAPL",
  "quantity": 10,
  "buyPrice": 100.00
}

### 3.2 Mai cumpara 10 AAPL la 200$ (Investitie: 2000$)
# Total ar trebui sa fie: 20 bucati.
# Pret Mediu: (1000 + 2000) / 20 = 150.00$
POST http://localhost:8080/api/portfolio
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "ticker": "AAPL",
  "quantity": 10,
  "buyPrice": 200.00
}

### 3.3 Verifica Portofoliul dupa Cumparari
# Asteptari: quantity=20, buyPrice=150.00
GET http://localhost:8080/api/portfolio
Authorization: Bearer {{auth_token}}

### ==========================================
### 4. VANZARE (PROFIT TAKING)
### ==========================================

### 4.1 Vinde 5 AAPL
POST http://localhost:8080/api/portfolio/sell
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "ticker": "AAPL",
  "quantity": 5
}

### 4.2 Verificarea Finala
# Asteptari: quantity=15 (20-5), buyPrice=150.00 (Neschiimbat!)
GET http://localhost:8080/api/portfolio
Authorization: Bearer {{auth_token}}